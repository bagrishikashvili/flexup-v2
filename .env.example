# ============================================
# flexup — Environment variables (example)
# Copy to .env and fill in actual values
# ============================================

# Application
NODE_ENV=development
LOG_LEVEL=debug

# Backend port (host)
BACKEND_PORT=3002

# Database
POSTGRES_PORT=55434
POSTGRES_PASSWORD=flexup
DATABASE_URL=postgresql://flexup:flexup@localhost:55434/flexup?schema=public

# Redis
REDIS_PORT=6381
REDIS_URL=redis://localhost:6381

# JWT — გენერირება: `openssl rand -hex 64`
JWT_ACCESS_SECRET=change_me_to_64_byte_hex
JWT_REFRESH_SECRET=change_me_to_different_64_byte_hex
JWT_ACCESS_TTL_SECONDS=900        # 15 წუთი
JWT_REFRESH_TTL_SECONDS=2592000   # 30 დღე

# CORS — comma-separated list of allowed origins (preferred). Fallback: CORS_ORIGIN.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ORIGIN=*

# Swagger / OpenAPI — enabled by default in dev. In production set to 'true' explicitly to expose /api/docs.
SWAGGER_ENABLED=true

# Uploads
UPLOADS_DIR=./uploads
UPLOADS_BASE_URL=http://localhost:3002/api/uploads
MAX_UPLOAD_SIZE_BYTES=5242880

# Cookies
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_REFRESH_TOKEN_NAME=flexup_refresh

# Email
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=noreply@flexup.local
EMAIL_FROM_NAME=flexup

# Web app URL (for email links)
WEB_BASE_URL=http://localhost:5173

# Email verification
EMAIL_VERIFICATION_TTL_HOURS=24
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_PER_DAY=5

# Password reset
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_PER_DAY=5

# Mailpit ports (dev)
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
