{
  "name": "flexup",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev -w apps/flexup-backend",
    "build:backend": "npm run build -w apps/flexup-backend",
    "build:shared": "npm run build -w @flexup/shared",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs:backend": "docker compose logs -f backend",
    "docker:logs:postgres": "docker compose logs -f postgres",
    "docker:logs:redis": "docker compose logs -f redis",
    "port:3000:kill": "bash -lc 'pids=$(lsof -ti :3000); if [ -n \"$pids\" ]; then kill -9 $pids; fi'",
    "db:migrate": "npm run prisma:migrate -w apps/flexup-backend",
    "db:migrate:dev": "npm run prisma:migrate:dev -w apps/flexup-backend",
    "db:generate": "npm run prisma:generate -w apps/flexup-backend",
    "db:seed": "npm run prisma:seed -w apps/flexup-backend",
    "db:seed:demo": "SEED_DEMO_DATA=true npm run prisma:seed -w apps/flexup-backend",
    "db:baseline": "npm run prisma:baseline -w apps/flexup-backend",
    "dev:web": "npm run dev -w apps/flexup-web"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "overrides": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native-reanimated": {
      "react-native-worklets": "0.7.4"
    }
  },
  "devDependencies": {
    "patch-package": "^8.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
